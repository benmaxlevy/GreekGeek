{
  "name": "greekgeek",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "concurrently --kill-others-on-fail \"pnpm run dev\" \"pnpm --filter @greekgeek/api run dev:worker\"",
    "dev:workers": "pnpm --filter @greekgeek/api run dev:worker",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "pnpm --filter @greekgeek/api exec prisma generate",
    "db:migrate": "pnpm --filter @greekgeek/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @greekgeek/api run prisma:seed",
    "db:studio": "pnpm --filter @greekgeek/api exec prisma studio",
    "test:api": "pnpm --filter @greekgeek/api test",
    "test:e2e": "pnpm --filter @greekgeek/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0"
  }
}
