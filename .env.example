# Copy to apps/api/.env (and optionally root .env) before running the API.
DATABASE_URL=postgresql://rally:rally@localhost:5432/rally?schema=public
PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-phase1-stub-secret-min-32-chars
WEB_ORIGIN=http://localhost:5173
# Public app base URL (Connect return/refresh redirects)
APP_URL=http://localhost:5173
# Local Redis from docker-compose (service: redis, port 6379)
REDIS_URL=redis://localhost:6379
# Stripe webhook signing secret (Stripe CLI or Dashboard); required at API boot
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Stripe secret key (Dashboard → Developers → API keys); required for API + worker
STRIPE_SECRET_KEY=sk_test_replace_me
# Stripe Accounts v2 preview pin (Connect uses /v2/core/accounts). Documented:
# https://docs.stripe.com/connect/accounts-v2 — bump when Stripe publishes a newer preview.
STRIPE_API_VERSION=2026-07-29.preview
# Rally platform fee percent on ticket price (default 10 → $10 ticket = $1 fee)
RALLY_FEE_PERCENT=10
# Max tickets one buyer can hold per event (paid+unpaid non-void); default 2
MAX_TICKETS_PER_USER_PER_EVENT=2
# Minutes before an open purchase expires; worker cancels PI and releases seats
PURCHASE_TTL_MINUTES=5
# FE publishable key for Stripe Payment Element (ticket checkout)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Days after event end (or start if no end) before auto payout eligibility; default 5
PAYOUT_HOLD_DAYS=5
