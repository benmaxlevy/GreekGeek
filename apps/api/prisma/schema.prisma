generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum OrganizationType {
  FRATERNITY
  SORORITY
}

enum TicketSaleStatus {
  draft
  on_sale
  closed
}

enum AllocationStatus {
  active
  closed
}

enum TicketStatus {
  unpaid
  paid
  void
}

enum PurchaseStatus {
  requires_payment
  succeeded
  failed
  canceled
}

enum EventPayoutStatus {
  pending
  released
  failed
  blocked
}

enum PayoutReleaseMode {
  auto
  manual
}

enum PayoutExcludedReason {
  disputed
  refunded
  voided
}

enum PayoutAuditAction {
  hold
  clear
  release
  retry
}

model User {
  id                      String         @id @default(cuid())
  email                   String         @unique
  name                    String
  passwordHash            String
  emailVerifiedAt         DateTime?
  role                    Role           @default(USER)
  status                  UserStatus     @default(PENDING)
  requestedOrganizationId String?
  requestedOrganization   Organization?  @relation("UserRequestedOrganization", fields: [requestedOrganizationId], references: [id], onDelete: SetNull)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  refreshTokens           RefreshToken[]
  membership              Membership?
  heldTickets             Ticket[]
  purchases               Purchase[]
  heldEvents               Event[]          @relation("EventHeldByUser")
  payoutReleases           EventPayout[]    @relation("EventPayoutReleasedByUser")
  payoutAuditRows           EventPayoutAudit[]

  @@index([requestedOrganizationId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model University {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]
}

model Organization {
  id                       String           @id @default(cuid())
  name                     String
  type                     OrganizationType
  universityId             String
  university               University       @relation(fields: [universityId], references: [id])
  stripeAccountId          String?          @unique
  stripeChargesEnabled     Boolean          @default(false)
  stripePayoutsEnabled     Boolean          @default(false)
  stripeTransfersEnabled   Boolean          @default(false)
  stripeDetailsSubmitted   Boolean          @default(false)
  stripeRequirementsDue    Json?
  stripeAccountUpdatedAt   DateTime?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  memberships              Membership[]
  events                   Event[]
  ticketAllocations        TicketAllocation[]
  requestedByUsers         User[]           @relation("UserRequestedOrganization")

  @@unique([universityId, name])
  @@index([universityId])
}

model Event {
  id                  String            @id @default(cuid())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id])
  name                String
  type                String
  maxHeadcount        Int
  startsAt            DateTime
  endsAt              DateTime?
  location            String?
  ticketingEnabled    Boolean           @default(false)
  ticketCapacity      Int?
  ticketSaleStatus    TicketSaleStatus?
  ticketSalesOpenAt   DateTime?
  ticketSalesCloseAt  DateTime?
  heldAt              DateTime?
  heldByUserId        String?
  heldByUser          User?             @relation("EventHeldByUser", fields: [heldByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  allocations         TicketAllocation[]
  purchases           Purchase[]
  payouts             EventPayout[]
  payoutAudits        EventPayoutAudit[]

  @@index([organizationId])
  @@index([startsAt, endsAt])
  @@index([heldAt])
}

model TicketAllocation {
  id             String           @id @default(cuid())
  eventId        String
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  quantity       Int
  priceCents     Int?
  status         AllocationStatus @default(active)
  tickets        Ticket[]
  purchases      Purchase[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([eventId, organizationId])
  @@index([eventId])
  @@index([organizationId])
}

model Ticket {
  id              String           @id @default(cuid())
  allocationId    String
  allocation      TicketAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  status          TicketStatus     @default(unpaid)
  credentialToken String           @unique
  holderUserId    String?
  holder          User?            @relation(fields: [holderUserId], references: [id])
  purchaseId      String?
  purchase        Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  paidAt          DateTime?
  voidedAt        DateTime?
  checkedIn       Boolean          @default(false)
  checkedInAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([allocationId])
  @@index([holderUserId])
  @@index([purchaseId])
}

model Purchase {
  id                    String           @id @default(cuid())
  buyerUserId           String
  buyer                 User             @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  eventId               String
  event                 Event            @relation(fields: [eventId], references: [id], onDelete: Restrict)
  allocationId          String
  allocation            TicketAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  quantity              Int
  subtotalCents         Int
  feeCents              Int
  amountCents           Int
  netCents              Int
  currency              String           @default("usd")
  status                PurchaseStatus
  stripePaymentIntentId String           @unique
  stripeChargeId        String?
  eventPayoutId         String?
  eventPayout           EventPayout?     @relation(fields: [eventPayoutId], references: [id], onDelete: SetNull)
  payoutExcludedReason  PayoutExcludedReason?
  statusMismatch        Boolean          @default(false)
  tickets               Ticket[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([eventId])
  @@index([eventPayoutId])
  @@index([eventId, status, eventPayoutId, payoutExcludedReason])
  @@index([buyerUserId, allocationId, status])
}

model EventPayout {
  id                 String             @id @default(cuid())
  eventId            String
  event               Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  batchSeq            Int
  amountCents         Int
  status              EventPayoutStatus
  releasedAt         DateTime?
  releaseMode        PayoutReleaseMode?
  releasedByUserId   String?
  releasedByUser     User?              @relation("EventPayoutReleasedByUser", fields: [releasedByUserId], references: [id], onDelete: SetNull)
  stripeTransferId   String?            @unique
  attempts           Int                @default(0)
  lastError          String?
  postReleaseExposure Boolean            @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  purchases          Purchase[]
  audits             EventPayoutAudit[]

  @@unique([eventId, batchSeq])
  @@index([eventId, status])
}

model EventPayoutAudit {
  id             String          @id @default(cuid())
  eventId        String
  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventPayoutId  String?
  eventPayout    EventPayout?    @relation(fields: [eventPayoutId], references: [id], onDelete: SetNull)
  actorUserId    String
  actorUser      User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action         PayoutAuditAction
  reason         String
  createdAt      DateTime        @default(now())

  @@index([eventId, createdAt])
  @@index([eventPayoutId])
}

model Membership {
  id             String             @id @default(cuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  permissions    MemberPermission[]

  @@index([organizationId])
}

model Permission {
  id          String             @id @default(cuid())
  key         String             @unique
  description String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  members     MemberPermission[]
}

model MemberPermission {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([membershipId, permissionId])
  @@index([permissionId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  service     String
  externalId  String
  type        String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@unique([service, externalId])
  @@index([processedAt])
}
