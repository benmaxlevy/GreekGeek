generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum OrganizationType {
  FRATERNITY
  SORORITY
}

enum TicketSaleStatus {
  draft
  on_sale
  closed
}

enum AllocationStatus {
  active
  closed
}

enum TicketStatus {
  unpaid
  paid
  void
}

model User {
  id                      String         @id @default(cuid())
  email                   String         @unique
  name                    String
  passwordHash            String
  emailVerifiedAt         DateTime?
  role                    Role           @default(USER)
  status                  UserStatus     @default(PENDING)
  requestedOrganizationId String?
  requestedOrganization   Organization?  @relation("UserRequestedOrganization", fields: [requestedOrganizationId], references: [id], onDelete: SetNull)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  refreshTokens           RefreshToken[]
  membership              Membership?
  heldTickets             Ticket[]

  @@index([requestedOrganizationId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model University {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  organizations Organization[]
}

model Organization {
  id               String           @id @default(cuid())
  name             String
  type             OrganizationType
  universityId     String
  university       University       @relation(fields: [universityId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  memberships         Membership[]
  events              Event[]
  ticketAllocations   TicketAllocation[]
  requestedByUsers    User[]             @relation("UserRequestedOrganization")

  @@unique([universityId, name])
  @@index([universityId])
}

model Event {
  id                  String            @id @default(cuid())
  organizationId      String
  organization        Organization      @relation(fields: [organizationId], references: [id])
  name                String
  type                String
  maxHeadcount        Int
  location            String?
  ticketingEnabled    Boolean           @default(false)
  ticketCapacity      Int?
  ticketSaleStatus    TicketSaleStatus?
  ticketSalesOpenAt   DateTime?
  ticketSalesCloseAt  DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  allocations         TicketAllocation[]

  @@index([organizationId])
}

model TicketAllocation {
  id             String           @id @default(cuid())
  eventId        String
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  quantity       Int
  priceCents     Int?
  status         AllocationStatus @default(active)
  tickets        Ticket[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([eventId, organizationId])
  @@index([eventId])
  @@index([organizationId])
}

model Ticket {
  id              String           @id @default(cuid())
  allocationId    String
  allocation      TicketAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  status          TicketStatus     @default(unpaid)
  credentialToken String           @unique
  holderUserId    String?
  holder          User?            @relation(fields: [holderUserId], references: [id])
  paidAt          DateTime?
  voidedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([allocationId])
  @@index([holderUserId])
}

model Membership {
  id             String             @id @default(cuid())
  userId         String             @unique
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  permissions    MemberPermission[]

  @@index([organizationId])
}

model Permission {
  id          String             @id @default(cuid())
  key         String             @unique
  description String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  members     MemberPermission[]
}

model MemberPermission {
  id           String     @id @default(cuid())
  membershipId String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([membershipId, permissionId])
  @@index([permissionId])
}
